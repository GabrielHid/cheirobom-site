---
// Arte decorativa com transparência (aquarelas de Natal): AVIF, com WebP de reserva, em vários tamanhos.
// O AVIF tem cerca de um terço do peso do WebP nessas aquarelas, sem diferença visível.
// Sempre decorativa: alt vazio e aria-hidden. As classes e os data-* vão para o <img>.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  widths: number[];
  sizes: string;
  class?: string;
  eager?: boolean;
  priority?: boolean;
  [key: `data-${string}`]: unknown;
}

const { src, widths, sizes, class: className, eager = false, priority = false, ...rest } = Astro.props;
---

<Picture
  src={src}
  formats={['avif']}
  fallbackFormat="webp"
  widths={widths.filter((w) => w <= src.width)}
  sizes={sizes}
  class={className}
  alt=""
  aria-hidden="true"
  loading={priority || eager ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : undefined}
  decoding="async"
  {...rest}
/>
