---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  widths?: number[];
  priority?: boolean;
  eager?: boolean;
  quality?: number;
  class?: string;
}

const { src, alt, sizes = '(min-width: 48rem) 50vw, 100vw', widths, priority = false, eager = false, quality, class: className } = Astro.props;
const candidates = (widths ?? [480, 768, 1080, 1536]).filter((w) => w <= src.width);
---

<Picture
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  fallbackFormat={src.format === 'png' ? 'png' : 'jpg'}
  widths={candidates}
  quality={quality}
  sizes={sizes}
  class={className}
  loading={priority || eager ? 'eager' : 'lazy'}
  decoding={priority ? 'sync' : 'async'}
  fetchpriority={priority ? 'high' : 'low'}
/>
